	'-DNO_IRR_USE_NON_SYSTEM_BZLIB_',
	'-DNO_IRR_USE_NON_SYSTEM_LIB_PNG_',
	'-DNO_IRR_USE_NON_SYSTEM_JPEG_LIB_',
